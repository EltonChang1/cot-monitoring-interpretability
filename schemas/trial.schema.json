{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planned CoT monitoring trial record",
  "description": "One assigned rollout. Cross-field and timing invariants also require the checks in docs/trial-record.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trial_id", "scenario_id", "template_group_id", "family", "split", "framing", "condition", "generation_seed", "status", "manifest_sha256", "checkpoint", "outcome", "monitors", "artifacts"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "trial_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "template_group_id": {"type": "string", "minLength": 1},
    "family": {"enum": ["ledger_integrity", "synthetic_data_routing", "score_integrity"]},
    "split": {"enum": ["preflight", "discovery", "monitor_fit", "threshold_calibration", "test"]},
    "framing": {"enum": ["evaluation", "operational"]},
    "condition": {"enum": ["none", "suppress", "enhance", "random"]},
    "generation_seed": {"type": "integer"},
    "status": {"enum": ["not_started", "valid", "invalid_json", "truncated", "missing_action", "ambiguous", "inference_failed"]},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_reasoning_tokens", "reasoning_tokens_observed", "boundary", "action_tokens_visible"],
      "properties": {
        "target_reasoning_tokens": {"const": 128},
        "reasoning_tokens_observed": {"type": "integer", "minimum": 0, "maximum": 128},
        "boundary": {"enum": ["token_budget", "reasoning_end", "unavailable"]},
        "action_tokens_visible": {"const": 0}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_violation", "task_success", "checker_version"],
      "properties": {
        "policy_violation": {"type": ["boolean", "null"]},
        "task_success": {"type": ["boolean", "null"]},
        "checker_version": {"type": ["string", "null"]}
      }
    },
    "monitors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "cot", "activation", "fusion"],
      "properties": {
        "task": {"$ref": "#/$defs/monitor"},
        "cot": {"$ref": "#/$defs/monitor"},
        "activation": {"$ref": "#/$defs/monitor"},
        "fusion": {"$ref": "#/$defs/monitor"}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "relative_path", "sha256"],
        "properties": {
          "kind": {"enum": ["tokens", "reasoning", "final_output", "activation_pre_hook", "activation_post_hook_diagnostic", "timing", "error"]},
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "threshold", "flagged"],
      "properties": {
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "flagged": {"type": ["boolean", "null"]}
      }
    }
  }
}
